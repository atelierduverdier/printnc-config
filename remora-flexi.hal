
# load the realtime components

	loadrt [KINS]KINEMATICS
	loadrt [EMCMOT]EMCMOT base_period_nsec=[EMCMOT]BASE_PERIOD servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS num_spindles=[TRAJ]SPINDLES

	loadrt flexi PRU_base_freq=120000
	loadrt not names=stepen_not,stepen_z_not,aux0_not,aux1_not,aux2_not,aux3_not,flood_not,mist_not
	loadrt estop_latch names=estop_latch
	loadrt and2 names=run_and,step_and
	loadrt toggle names=hold_button_toggle
	loadrt toggle2nist names=hold_toggle,paused_toggle
	loadrt or2 names=aux0_or,aux1_or,aux2_or,aux3_or,cool_or1,cool_or2
	loadrt timedelay names=spindle_cooldown


# add the remora and motion functions to threads

	addf flexi.read servo-thread
	addf motion-command-handler servo-thread
	addf motion-controller servo-thread
	addf flexi.update-freq servo-thread
	addf flexi.write servo-thread
	addf stepen_not servo-thread
	addf stepen_z_not servo-thread
	addf aux0_not servo-thread
	addf aux1_not servo-thread
	addf aux2_not servo-thread
	addf aux3_not servo-thread
	addf flood_not servo-thread
	addf mist_not servo-thread
	addf estop_latch servo-thread
	addf run_and servo-thread
	addf step_and servo-thread
	addf hold_toggle servo-thread
	addf hold_button_toggle servo-thread
	addf aux0_or servo-thread
	addf aux1_or servo-thread
	addf aux2_or servo-thread
	addf aux3_or servo-thread
	addf cool_or1 servo-thread
	addf cool_or2 servo-thread
	addf spindle_cooldown servo-thread


#toggle2nist states & mux selectors
	net program-is-paused hold_toggle.is-on <= halui.program.is-paused


# hy_vfd - uncomment the below if using hy_vfd. Use ttyAMA3 for Pi 4 and ttyAMA2 for Pi 5
	loadusr -Wn vfd hy_vfd -n vfd -d /dev/ttyAMA2 -p none -r 9600 -s 1
	loadrt scale names=spindle_fb_scale
	addf spindle_fb_scale servo-thread
	setp spindle_fb_scale.gain 0.016666667 # 1/60  to convert rpm to rps
	setp vfd.enable 1
	net spindle-speed-cmd vfd.speed-command <= spindle.0.speed-out
	net spindle-fb-scale-in vfd.spindle-speed-fb => spindle_fb_scale.in
	net spindle-speed-fb spindle_fb_scale.out => spindle.0.speed-in
	net spindle-at-speed vfd.spindle-at-speed => spindle.0.at-speed
	net spindle-forward vfd.spindle-forward => spindle.0.forward
	net spindle-reverse vfd.spindle-reverse => spindle.0.reverse
	net spindle-on vfd.spindle-on => spindle.0.on
	net spindle-comm-ok <= vfd.hycomm-ok

# Post-refroidissement : quand la broche tourne, spindle_cooldown.out est vrai.
# Quand la broche s'arrete (M5), il reste vrai encore 30 s (off-delay).
# on-delay 0 = pas de retard a l'allumage. off-delay 30 = 30 s apres l'arret.
	setp spindle_cooldown.on-delay 0
	setp spindle_cooldown.off-delay 30
	net spindle-on => spindle_cooldown.in
	
# Analog spindle control - Uncomment if using PWM or analog. You will also need to comment out spindle_load.hal in postgui_call_list.hal.
	#loadrt scale names=spindle_speed_scale
	#addf spindle_speed_scale servo-thread
	#setp spindle_speed_scale.gain 0.004167 # volts per RPM, calculated over full scale. [max output voltage]/[Max spindle speed] * 10 Example: 0-10V, 24000 rpm: (10/24000) * 10 = 0.004167
	#net spindle-scale-in spindle.0.speed-out => spindle_speed_scale.in
	#net spindle-speed-scaled spindle_speed_scale.out => flexi.SP.SPINDLE_PWM
	#net spindle-enable spindle.0.on => flexi.output.SPINDLE_EN

# ============================================================
# LASER (LaserTree LT-80W-AA-PRO) - pilote comme spindle.1
# Puissance : S0..1000 (spindle.1) -> flexi.SP.SPINDLE_PWM -> PA8 -> 0-10V
#             -> convertisseur externe 0-10V vers PWM -> fil jaune laser
# Interlock  : spindle.1.on -> flexi.output.AUX3 -> relais 24V actif-bas
#             -> contact NO ferme le +24V vers VCC laser (fil rouge)
# Commande   : M3 $1 S<puissance>  /  M5 $1
#
# AUX3 est desormais dedie au laser (voir plus bas section AUX, le
# net aux3-gcode a ete commente pour eviter tout conflit).
#
# ATTENTION avant premier chargement : verifier qu'aucun net existant
# (custom_postgui.hal ou fichier source par postgui_call_list.hal) ne
# relie encore aux3_or.out ou un bouton QtDragon a flexi.output.AUX3.
# Sinon HAL refuse de charger (pin deja connectee). Verification :
#   grep -rn "flexi.output.AUX3" ~/linuxcnc/configs/flexi-hal/
# ============================================================

	loadrt scale names=laser_scale
	addf   laser_scale servo-thread
	setp   laser_scale.gain   0.102
	setp   laser_scale.offset -6
# CALIBRE par mesure reelle (10 juillet 2026), laser debranche a chaque etape.
#
# Passe 1 (gain=0.1, offset=0) :
#   S100=1.68V S250=3.13V S500=5.55V S750=7.97V S1000=10.43V S0=0.74V
#   Regression : V = 0.00971*S + 0.70 (fit excellent, ecarts <0.02V).
#   -> plancher ~0.7V confirme des S0, independant de S.
#
# Essai offset=-79 (mauvaise hypothese sur l'ordre offset/gain du
# composant scale) : a clampe S0 ET S500 au meme plancher (~0.73V),
# S1000 seulement 2.75V. Diagnostic : le firmware flexi clampe toute
# commande interne negative a 0 -- confirme le plancher irrattrapable
# en dessous d'un certain seuil de S.
#
# Passe 2 (gain=0.096, offset=-6) :
#   S0=0.73 S100=1.11 S200=2.06 S300=3.05 S400=4.00 S500=4.98 S600=5.93
#   S700=6.92 S800=7.87 S900=8.85 S1000=9.79
#   Regression (S100-S1000, zone non clampee) : V = 0.00964*S + 0.146
#   -> offset=-6 reduit bien l'ordonnee a l'origine dans la zone utile
#      (0.70V -> 0.146V), mais S0 reste clampe au meme plancher ~0.73V.
#   Gain ajuste 0.096->0.098 pour viser 10.0V a S1000 (0.096*10/9.79).
#
# CONCLUSION : le plancher ~0.73V a S0 (et en dessous d'environ S60-100)
# est IRRATTRAPABLE cote HAL (clampage firmware). NE PAS compter sur S0
# seul pour "laser eteint" pendant un job arme -- c'est l'interlock
# materiel (AUX3, spindle.1.on) qui garantit l'extinction reelle.
# Verifier au banc, laser branche a faible puissance, si ce residu
# marque le materiau aux vitesses de rapide.
#
# A REVERIFIER apres ce changement : M3 $1 S1000 doit lire ~10.0V.
#
# Reverifier apres ce changement : M3 $1 S1000 doit maintenant lire ~10.0V.

	net laser-spd  spindle.1.speed-out => laser_scale.in
	net laser-pwm  laser_scale.out     => flexi.SP.SPINDLE_PWM
	net laser-arm  spindle.1.on        => flexi.output.AUX3

# estop loopback, SPI comms enable and feedback
	net user-enable-out iocontrol.0.user-enable-out => flexi.SPI-enable
	net user-request-enable iocontrol.0.user-request-enable => flexi.SPI-reset estop_latch.reset
	#estop_latch returns 'ok' when fault-in is false, ok-in is true, and reset changes from false to true. 
	net estop-fault_in flexi.input.HALT.not => estop_latch.fault-in
	net remora-status flexi.SPI-status => estop_latch.ok-in
	net estop-status estop_latch.ok-out => iocontrol.0.emc-enable-in


# Joint 0 setup

	setp flexi.joint.0.scale [JOINT_0]SCALE
	setp flexi.joint.0.maxaccel [JOINT_0]STEPGEN_MAXACCEL
	setp flexi.joint.0.pgain [JOINT_0]P_GAIN
	setp flexi.joint.0.ff1gain [JOINT_0]FF1_GAIN
	setp flexi.joint.0.deadband [JOINT_0]DEADBAND

	net xpos-cmd joint.0.motor-pos-cmd => flexi.joint.0.pos-cmd
	net j0pos-fb flexi.joint.0.pos-fb => joint.0.motor-pos-fb
	net j0enable joint.0.amp-enable-out => flexi.joint.0.enable flexi.output.STEP_EN

	net x-home joint.0.home-sw-in => flexi.input.X_LIMIT.not


# Joint 1 setup

	setp flexi.joint.1.scale [JOINT_1]SCALE
	setp flexi.joint.1.maxaccel [JOINT_1]STEPGEN_MAXACCEL
	setp flexi.joint.1.pgain [JOINT_1]P_GAIN
	setp flexi.joint.1.ff1gain [JOINT_1]FF1_GAIN
	setp flexi.joint.1.deadband [JOINT_1]DEADBAND

	net j1pos-cmd joint.1.motor-pos-cmd => flexi.joint.1.pos-cmd
	net j1pos-fb flexi.joint.1.pos-fb => joint.1.motor-pos-fb
	net j1enable joint.1.amp-enable-out => flexi.joint.1.enable

	net y-home joint.1.home-sw-in => flexi.input.Y_LIMIT.not


# Joint 2 setup

	setp flexi.joint.2.scale [JOINT_2]SCALE
	setp flexi.joint.2.maxaccel [JOINT_2]STEPGEN_MAXACCEL
	setp flexi.joint.2.pgain [JOINT_2]P_GAIN
	setp flexi.joint.2.ff1gain [JOINT_2]FF1_GAIN
	setp flexi.joint.2.deadband [JOINT_2]DEADBAND

	net j2pos-cmd joint.2.motor-pos-cmd => flexi.joint.2.pos-cmd
	net j2pos-fb flexi.joint.2.pos-fb => joint.2.motor-pos-fb
	#net j2enable joint.2.amp-enable-out => flexi.joint.2.enable flexi.output.STEP_EN_Z flexi.joint.2.enable flexi.joint.3.enable
	net j2enable joint.2.amp-enable-out => flexi.joint.2.enable
	net z-home joint.2.home-sw-in => flexi.input.Z_LIMIT.not


# Joint 3 setup

	setp flexi.joint.3.scale [JOINT_3]SCALE
	setp flexi.joint.3.maxaccel [JOINT_3]STEPGEN_MAXACCEL
	setp flexi.joint.3.pgain [JOINT_3]P_GAIN
	setp flexi.joint.3.ff1gain [JOINT_3]FF1_GAIN
	setp flexi.joint.3.deadband [JOINT_3]DEADBAND

	net j3pos-cmd joint.3.motor-pos-cmd => flexi.joint.3.pos-cmd
	net j3pos-fb flexi.joint.3.pos-fb => joint.3.motor-pos-fb
	net j3enable joint.3.amp-enable-out => flexi.joint.3.enable

	net A-home joint.3.home-sw-in => flexi.input.A_LIMIT.not


# Joint 4 setup

#	setp flexi.joint.4.scale [JOINT_4]SCALE
#	setp flexi.joint.4.maxaccel [JOINT_4]STEPGEN_MAXACCEL
#   setp flexi.joint.4.pgain [JOINT_4]P_GAIN
#	setp flexi.joint.4.ff1gain [JOINT_4]FF1_GAIN
#	setp flexi.joint.4.deadband [JOINT_4]DEADBAND

#	net j4pos-cmd joint.4.motor-pos-cmd => flexi.joint.4.pos-cmd
#	net j4pos-fb flexi.joint.4.pos-fb => joint.4.motor-pos-fb
#	net j4enable joint.4.amp-enable-out => flexi.joint.4.enable

#	net b-home joint.4.home-sw-in => flexi.input.B_LIMIT

# Motor enables

	#inverted 
	#net j0enable => stepen_not.in
	#net stepen_inv stepen_not.out <= flexi.output.STEP_EN
	#net j2enable => stepen_z_not.in
	#net stepen_z_inv stepen_z_not.out <= flexi.output.STEP_EN_Z

	#non-inverted
	net j0enable => flexi.output.STEP_EN
	net j2enable => flexi.output.STEP_EN_Z



# Flood and mist outputs (inverses pour relais active LOW)
#	net flood iocontrol.0.coolant-flood => flood_not.in
#	net flood-inv flood_not.out => flexi.output.COOLANT
#	net mist iocontrol.0.coolant-mist => mist_not.in
#	net mist-inv mist_not.out => flexi.output.MIST
	
# Sorties auxiliaires (pilotables par M64/M65, inverses pour relais active LOW)
#	net aux0-sig motion.digital-out-00 => aux0_not.in
#	net aux0-inv aux0_not.out => flexi.output.AUX0
#	net aux1-sig motion.digital-out-01 => aux1_not.in
#	net aux1-inv aux1_not.out => flexi.output.AUX1
#	net aux2-sig motion.digital-out-02 => aux2_not.in
#	net aux2-inv aux2_not.out => flexi.output.AUX2
#	net aux3-sig motion.digital-out-03 => aux3_not.in
#	net aux3-inv aux3_not.out => flexi.output.AUX3


# Flood and mist outputs
# Le flood (pompe) est actif si : M8 (coolant-flood) OU post-refroidissement broche.
# cool_or1 combine la commande M8 et le cooldown de la broche.
	net coolant-m8 iocontrol.0.coolant-flood => cool_or1.in0
	net spindle-cooldown spindle_cooldown.out => cool_or1.in1
	net cooling-active cool_or1.out => flexi.output.COOLANT
	net mist flexi.output.MIST <= iocontrol.0.coolant-mist
	
# Sorties auxiliaires : entree G-code (M64/M65) vers les or2.
# Les boutons QtDragon et la sortie vers flexi.output.AUX sont dans
# custom_postgui.hal (les pins des boutons n'existent qu'apres chargement du GUI).
	net aux0-gcode motion.digital-out-00 => aux0_or.in0
	net aux1-gcode motion.digital-out-01 => aux1_or.in0
	net aux2-gcode motion.digital-out-02 => aux2_or.in0
# AUX3 reserve au laser (interlock spindle.1, voir section LASER plus haut).
# M64 P3 / M65 P3 et le bouton QtDragon AUX3 n'ont plus d'effet.
#	net aux3-gcode motion.digital-out-03 => aux3_or.in0

# User buttons
	#Halt is shared with motor alarms and is up in the estop loop.

	#Hold logic
	net hold_button flexi.input.FEED_HOLD => hold_button_toggle.in
	net hold_toggle_latch hold_button_toggle.out => hold_toggle.in
	net hold_on halui.program.pause <= hold_toggle.on
	net hold_off halui.program.resume <= hold_toggle.off

	#Cycle start logic. Lance le programme uniquement quand il est idle.
	#CYCLE_START est actif HAUT (FALSE au repos, TRUE en appui) : pas de .not ici.
	#Plus de single-step automatique => plus de redemarrage en boucle.
	net cycle-start-button flexi.input.CYCLE_START => run_and.in0
	net program-is-idle halui.program.is-idle => run_and.in1
	net program-run run_and.out => halui.program.run
# ==================== Ancienne logique CYCLE START (buggee, desactivee) =======
# Cause du bug "le programme redemarre en boucle / Stop ne tient pas" :
#   - CYCLE_START.not est TRUE au repos (car CYCLE_START est actif haut)
#   - => run_and.in0 reste TRUE en permanence sauf pendant l'appui
#   - => dès que program-is-idle redevient TRUE, le programme repart seul
#
#net run-step_button flexi.input.CYCLE_START.not => run_and.in0 step_and.in0
#net program-is-idle halui.program.is-idle => run_and.in1 #if not running AND button pressed
#net program-run run_and.out => halui.program.run #run program
#net program-is-paused halui.program.is-paused => step_and.in1 #if paused AND button pressed
#net single-step step_and.out => halui.program.step #single step

# Probe
	net probe_input motion.probe-input <= flexi.input.PROBE.not

# Manual toolchange

	#These are for axis, uncomment these and remove 'source qtdragon_hd.hal' from postgui_call_list.hal if using axis GUI.
	#loadusr -W hal_manualtoolchange
	#net tool-change iocontrol.0.tool-change => hal_manualtoolchange.change
	#net tool-changed iocontrol.0.tool-changed <= hal_manualtoolchange.changed
	#net tool-number iocontrol.0.tool-prep-number => hal_manualtoolchange.number
	#net tool-prepare-loopback iocontrol.0.tool-prepare => iocontrol.0.tool-prepared
	
	#This is for qtdradon_hd, comment out of using axis.
	net tool-prepare-loopback iocontrol.0.tool-prepare => iocontrol.0.tool-prepared



	
