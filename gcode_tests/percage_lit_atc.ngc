G1 Z[#<z_haut> + [#<z_bas> - #<z_haut>] * 0.7500] F#<feed_z>
G1 X[37.500 + 3.0000] Y[0.000] F#<feed_xy>
G3 I-3.0000 J0
G1 X[37.500 + 6.0000] Y[0.000] F#<feed_xy>
G3 I-6.0000 J0
G1 X[37.500 + 9.0000] Y[0.000] F#<feed_xy>
G3 I-9.0000 J0
G1 X[37.500 + 12.0000] Y[0.000] F#<feed_xy>
G3 I-12.0000 J0
