# =========================================================================
# HAL DE SIMULATION - PrintNC Flexi-HAL (Atelier du Verdier)
# Pour developper l'interface QtDragon sur PC, SANS le materiel reel.
# Remplace le composant "flexi" (carte SPI) et le VFD serie par des
# equivalents simules. NE PAS utiliser sur la machine reelle.
# =========================================================================

# ---- Composants temps reel ----
	loadrt [KINS]KINEMATICS
	loadrt [EMCMOT]EMCMOT base_period_nsec=[EMCMOT]BASE_PERIOD servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS

# Les composants logiques de la config reelle sont conserves a l'identique
	loadrt not names=stepen_not,stepen_z_not,aux0_not,aux1_not,aux2_not,aux3_not,flood_not,mist_not
	loadrt estop_latch names=estop_latch
	loadrt and2 names=run_and,step_and,palpeur_et1,palpeur_et2
	loadrt toggle names=hold_button_toggle
	loadrt toggle2nist names=hold_toggle,paused_toggle
	loadrt or2 names=aux0_or,aux1_or,aux2_or,aux3_or
	loadrt comp names=palpeur_sim
	loadrt wcomp names=palpeur_x,palpeur_y

# ---- Fonctions dans le thread servo ----
	addf motion-command-handler servo-thread
	addf motion-controller servo-thread
	addf stepen_not servo-thread
	addf stepen_z_not servo-thread
	addf aux0_not servo-thread
	addf aux1_not servo-thread
	addf aux2_not servo-thread
	addf aux3_not servo-thread
	addf flood_not servo-thread
	addf mist_not servo-thread
	addf palpeur_sim servo-thread
	addf palpeur_x servo-thread
	addf palpeur_y servo-thread
	addf palpeur_et1 servo-thread
	addf palpeur_et2 servo-thread
	addf estop_latch servo-thread
	addf run_and servo-thread
	addf step_and servo-thread
	addf hold_toggle servo-thread
	addf hold_button_toggle servo-thread
	addf aux0_or servo-thread
	addf aux1_or servo-thread
	addf aux2_or servo-thread
	addf aux3_or servo-thread

# toggle2nist state
	net program-is-paused hold_toggle.is-on <= halui.program.is-paused

# ---- Estop simule (boucle simple) ----
	net user-enable-out iocontrol.0.user-enable-out => estop_latch.reset
	net estop-status estop_latch.ok-out => iocontrol.0.emc-enable-in
	setp estop_latch.fault-in 0
	setp estop_latch.ok-in 1

# =========================================================================
# SIMULATION DES JOINTS : on boucle commande -> feedback
# (au lieu de passer par flexi.joint.N). La machine "bouge" virtuellement.
# =========================================================================
	net j0pos joint.0.motor-pos-cmd => joint.0.motor-pos-fb
	net j1pos joint.1.motor-pos-cmd => joint.1.motor-pos-fb
	net j2pos joint.2.motor-pos-cmd => joint.2.motor-pos-fb
	net j3pos joint.3.motor-pos-cmd => joint.3.motor-pos-fb

# Capteurs de home simules : a 0, jamais declenches (homing immediat possible)
	setp joint.0.home-sw-in 0	
	setp joint.1.home-sw-in 0
	setp joint.2.home-sw-in 0
	setp joint.3.home-sw-in 0

# =========================================================================
# PALPEUR SIMULE
# =========================================================================
# `motion.probe-input` etait fige a 0. Un G38.2 partait donc pour toute sa
# course et finissait en erreur « probe move finished without tripping » :
# le banc ne pouvait pas eprouver un palpage, donc pas toolchange.ngc, qui
# n'est presque QUE ca.
#
# Le palpeur se declenche quand la broche est AU-DESSUS DE LA PASTILLE et
# descend sous un niveau donne. Les trois conditions sont necessaires, et
# la troisieme a ete apprise a la dure.
#
# Z : `comp.out` est vrai quand in1 > in0 (man 9 comp). On met donc le
# NIVEAU en in1 et la position en in0, et la sortie passe a vrai des que Z
# est plus bas que le niveau. -51.1 n'est pas un chiffre rond : c'est le
# contact MESURE du nez du laser sur la pastille, le 17/08/2026, imprime
# par le palpage lui-meme en coordonnees machine.
#
# X ET Y : un palpeur qui ne juge que Z ne se contente pas de se declencher
# au mauvais endroit -- LinuxCNC REFUSE TOUT MOUVEMENT ordinaire tant que
# l'entree est active (« Probe tripped during non-probe move »). La
# sequence du magasin, qui plonge sous -51 pour visser, s'arretait donc net
# au premier poste. Trouve en repetant l'ATC au banc : le defaut etait dans
# le banc, pas dans l'ATC.
#
# La fenetre Y couvre les DEUX visees, 60 pour une fraise et 150 pour le
# laser (son nez pend 90 mm en avant de la broche), et s'arrete avant le
# magasin suppose a Y200.
#
# Ce que ce palpeur ne simule pas : la longueur de l'outil monte. Il sert a
# derouler la sequence, pas a valider une cote.
	setp palpeur_sim.in1 -51.1
	net z-machine-sim axis.z.pos-cmd => palpeur_sim.in0

	setp palpeur_x.min -53.0
	setp palpeur_x.max -46.0
	setp palpeur_y.min  50.0
	setp palpeur_y.max 160.0
	net x-machine-sim axis.x.pos-cmd => palpeur_x.in
	net y-machine-sim axis.y.pos-cmd => palpeur_y.in

# au-dessus de la pastille (X ET Y), puis sous le niveau (Z)
	net palpeur-sur-x  palpeur_x.out   => palpeur_et1.in0
	net palpeur-sur-y  palpeur_y.out   => palpeur_et1.in1
	net palpeur-sur-xy palpeur_et1.out => palpeur_et2.in0
	net palpeur-sous-z palpeur_sim.out => palpeur_et2.in1
	net palpeur-touche palpeur_et2.out => motion.probe-input

# =========================================================================
# SIMULATION BROCHE (remplace le VFD hy_vfd)
# =========================================================================
	loadrt scale names=spindle_fb_scale
	addf spindle_fb_scale servo-thread
	setp spindle_fb_scale.gain 1.0
	net spindle-speed-cmd spindle.0.speed-out => spindle_fb_scale.in
	net spindle-speed-fb spindle_fb_scale.out => spindle.0.speed-in
# La broche est "at speed" des qu'elle est commandee (simulation)
	net spindle-on spindle.0.on => spindle.0.at-speed

# =========================================================================
# Flood and mist outputs (boucle, sorties simulees)
# =========================================================================
	net flood iocontrol.0.coolant-flood
	net mist iocontrol.0.coolant-mist

# =========================================================================
# Sorties auxiliaires : entree G-code (M64/M65) vers les or2.
# Les boutons QtDragon et la sortie sont dans custom_postgui.hal.
# En simulation, la sortie des or2 n'alimente aucune carte : on cree des
# signaux de sortie "en l'air" pour pouvoir les observer dans halshow.
# =========================================================================
	net aux0-gcode motion.digital-out-00 => aux0_or.in0
	net aux1-gcode motion.digital-out-01 => aux1_or.in0
	net aux2-gcode motion.digital-out-02 => aux2_or.in0
	net aux3-gcode motion.digital-out-03 => aux3_or.in0

# ---- Changement d'outil : DEUX boucles de retour, et pas comme la machine ----
# Le commentaire disait ici « identique a la config reelle » : c'etait faux, et
# ca coutait cher. La machine reelle passe par hal_manualtoolchange
# (qtdragon_hd.hal), qui ouvre une boite de dialogue et repond quand
# l'operateur a monte l'outil. Ce composant n'est PAS charge en simulation, si
# bien que personne ne repondait a `tool-change` : la premiere boucle etait la,
# la seconde manquait.
#
# Consequence mesuree le 17/08/2026 : un `T100 M6` figeait la tache dans
# WAITING_FOR_MOTION_AND_IO, pour toujours, SANS UN MOT. Et pas seulement le
# M6 -- plus rien ne s'executait ensuite, pas meme un (DEBUG, ...). L'ecran
# restait normal, la machine repondait, le journal ne disait rien. Autrement
# dit, le banc ne pouvait pas eprouver toolchange.ngc, qui est justement le
# sous-programme qu'on y modifie le plus.
#
# La boucle rend la main tout de suite : en simulation, le changement est
# repute fait. La difference avec la machine reste visible la ou il faut --
# toolchange.ngc porte son propre M1 (« Verifiez que l outil est bien monte »),
# qui lui s'arrete dans les deux cas.
	net tool-prepare-loopback iocontrol.0.tool-prepare => iocontrol.0.tool-prepared
	net tool-changed-loopback iocontrol.0.tool-change  => iocontrol.0.tool-changed
